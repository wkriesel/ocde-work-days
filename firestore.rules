rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // User profile and settings
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Annual year documents (days map + metadata)
      match /years/{yearId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Audit / undo logs
      match /years/{yearId}/logs/{logId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Future: supervisor read access
    // match /users/{userId} {
    //   allow read: if request.auth != null
    //     && request.auth.uid in resource.data.supervisors;
    //   match /years/{yearId} {
    //     allow read: if request.auth != null
    //       && request.auth.uid in get(/databases/$(database)/documents/users/$(userId)).data.supervisors;
    //   }
    // }
  }
}
